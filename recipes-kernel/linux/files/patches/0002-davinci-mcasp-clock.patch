+static void set_gpio_output(struct gpio_desc *gpio, int value)
+{
+	int ret;
+
+	if (!gpio)
+		return;
+
+	ret = gpiod_direction_output(gpio, value);
+	if (ret) {
+		pr_err("Failed to set GPIO direction to output, error %d\n", ret);
+		return;
+	}
+
+	gpiod_set_value_cansleep(gpio, value);
+
+	pr_info("GPIO set to %s\n", value ? "HIGH" : "LOW");
+}
