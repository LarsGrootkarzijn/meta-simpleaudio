#!/bin/sh
set -e
echo "Starting custom initramfs..."

# --- basic mounts ---
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run

udhcpc || echo "Warning: DHCP failed"

wait_for_network() {
    echo "Waiting for network..."
    for i in $(seq 1 10); do
        udhcpc && ping -c1 8.8.8.8 >/dev/null 2>&1 && return 0
        echo "Network not ready, retry $i/10..."
        sleep 3
    done
    echo "ERROR: Network unavailable!"
    return 1
}

echo "Press ENTER within 3s to drop to shell..."
if read -t 3 input; then
    echo "Dropping to shell..."
    exec /bin/sh
fi

mkdir -p /mnt/root /mnt/vfat
ROOT_DEV="/dev/mmcblk0p2"
VFAT="/dev/mmcblk0p1"
goto_flash=0

# --- validate partitions ---
if [ ! -b "$VFAT" ]; then
    echo "ERROR: VFAT device missing"
    goto_flash=1
elif [ ! -b "$ROOT_DEV" ]; then
    echo "ERROR: Root device missing"
    goto_flash=1
elif ! mount "$ROOT_DEV" /mnt/root 2>/dev/null; then
    echo "ERROR: Could not mount rootfs"
    goto_flash=1
elif ! mount -t vfat "$VFAT" /mnt/vfat 2>/dev/null; then
    echo "ERROR: Could not mount vfat"
    goto_flash=1
elif [ ! -f /mnt/root/simpleaudio-port-installed ] || [ ! -f /mnt/root/sbin/init ]; then
    echo "Rootfs invalid!"
    goto_flash=1
fi

#CHANGE TO PROD WHEN DONE

# --- stage ---
if [ -f "/mnt/vfat/stage" ]; then
    STAGE=$(tr -d ' \n\r' < /mnt/vfat/stage)
else
    echo "Warning: stage missing, defaulting to prod"
    STAGE="dev"
fi


#CHANGE TO PROD WHEN DONE
case "$STAGE" in
    prod|dev) ;;
    *) echo "Invalid stage, defaulting to prod"; STAGE="dev";;
esac

# --- machine detection ---
ARCH=$(uname -m)
case "$ARCH" in
    armv7*|armv7l)
        MACHINE="roomplayer-plus"
        ;;
    armv5*|armv5tel)
        MACHINE="roomplayer-i-ii"
        ;;
    *)
        echo "Unsupported arch: $ARCH"
        goto_flash=1
        ;;
esac

# --- flashing ---
IMAGE_FILE="simpleaudio-image-${MACHINE}.rootfs.wic.gz"
IMAGE_URL="http://${STAGE}.larsgrootkarzijn.nl/${IMAGE_FILE}"
IMAGE_LOCAL="/images/${IMAGE_FILE}"
mkdir -p /images

if [ "$goto_flash" -eq 1 ]; then
    echo "Starting flash..."
    if ! wait_for_network; then
        echo "Cannot flash, dropping to shell..."
        exec /bin/sh
    fi

    if [ ! -f "$IMAGE_LOCAL" ]; then
        echo "Downloading $IMAGE_FILE..."
        wget -O "$IMAGE_LOCAL" "$IMAGE_URL" || { echo "Download failed"; exec /bin/sh; }
    fi

    # DO CHECKSUM SOME DAY

    FLASH_RETRIES=3
    for i in $(seq 1 $FLASH_RETRIES); do
        umount /mnt/root /mnt/vfat 2>/dev/null || true
        sync
        echo "Flashing attempt $i/$FLASH_RETRIES..."
        #zcat /images/simpleaudio-image-roomplayer-plus.rootfs.wic.gz | dd of=/dev/mmcblk0 bs=4M
        if zcat "$IMAGE_LOCAL" | dd of=/dev/mmcblk0 bs=4M; then
            sync
            echo "Flash complete, rebooting..."
            exec reboot -f
        else
            echo "Flash failed, retrying..."
            sleep 2
        fi
    done

    echo "ERROR: Flash failed after retries, dropping to shell..."
    exec /bin/sh
fi

# --- normal boot ---
echo "Rootfs OK, continuing boot..."
mount --move /proc /mnt/root/proc
mount --move /sys /mnt/root/sys
mount --move /dev /mnt/root/dev
mount --move /run /mnt/root/run
mount --move /mnt/vfat /mnt/root/boot

# switch naar echte rootfs
exec switch_root /mnt/root /sbin/init